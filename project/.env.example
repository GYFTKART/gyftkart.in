# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Razorpay (required for card/netbanking checkout)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# YouPI-PG (optional — direct UPI gateway, self-hosted).
# Leave VITE_YOUPI_API_URL empty to hide the YouPI option in checkout.
VITE_YOUPI_PUBLIC_KEY=
# e.g. https://pay.gyftkart.in  (the payment REST API origin, YouPI port 6100 behind a proxy)
VITE_YOUPI_API_URL=
# e.g. https://checkout.gyftkart.in  (the checkout portal origin, YouPI port 7000 behind a proxy)
VITE_YOUPI_PORTAL_URL=
