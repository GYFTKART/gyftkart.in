# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Razorpay (configurable in Admin Settings; disabled by default)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# UPI Direct (serverless direct-UPI on Supabase; ₹0 infra)
VITE_UPI_DIRECT_ENABLED=true
