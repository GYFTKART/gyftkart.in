# ==============================================================================
# GyftKart Production Environment Configuration (.env.production)
# ==============================================================================

# Core Application & Custom Domain
VITE_SITE_URL=https://gyftkart.in
VITE_APP_NAME="GyftKart"

# Supabase Production Backend (Strict HTTPS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_production_supabase_anon_key

# Razorpay Payment Gateway (Configurable in Admin Settings; disabled by default)
VITE_RAZORPAY_KEY_ID=rzp_live_your_live_key_id

# UPI Direct Payment Mode (Serverless Direct-UPI on Supabase)
# Instant bank QR & UTR verification
VITE_UPI_DIRECT_ENABLED=true
