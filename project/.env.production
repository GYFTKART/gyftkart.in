# ==============================================================================
# GyftKart Production Environment Configuration (.env.production)
# ==============================================================================

# Core Application & Custom Domain
VITE_SITE_URL=https://gyftkart.in
VITE_APP_NAME="GyftKart"

# Supabase Production Backend (Strict HTTPS)
# Replace with your production Supabase project credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_production_supabase_anon_key

# Razorpay Payment Gateway (Live Credentials)
# Production Key ID begins with rzp_live_
VITE_RAZORPAY_KEY_ID=rzp_live_your_live_key_id

# UPI Direct Payment Mode (Serverless Direct-UPI on Supabase)
# Set to true to activate instant bank QR & UTR verification
VITE_UPI_DIRECT_ENABLED=true

# YouPI-PG Gateway (Optional - Self-Hosted UPI Gateway)
# Leave empty if using Razorpay or UPI Direct exclusively
VITE_YOUPI_PUBLIC_KEY=
VITE_YOUPI_API_URL=
VITE_YOUPI_PORTAL_URL=
